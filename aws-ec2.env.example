# MySQL en Amazon RDS (recomendado) o en otro servidor privado.
# Codifica caracteres especiales del usuario/password como URL.
DATABASE_URL="mysql://USUARIO:PASSWORD@HOST_RDS:3306/walkinglodge"

# URL publica final, sin barra al final.
NEXTAUTH_URL="https://walkinglodge.com"

# Generar en EC2 con: openssl rand -base64 32
NEXTAUTH_SECRET="REEMPLAZAR_POR_UN_SECRETO_LARGO"

# Solo se utiliza al crear el administrador por primera vez con npm run seed.
SEED_ADMIN_PASSWORD="REEMPLAZAR_POR_UN_PASSWORD_ADMIN_SEGURO"
